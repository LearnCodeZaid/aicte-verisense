# Copy to backend/.env and adjust. All variables are optional.
VERISENSE_SECRET=change-me-to-a-long-random-string
# SQLite file path or full SQLAlchemy URL
VERISENSE_DB=data/verisense.db
VERISENSE_STORAGE=storage
# Synthetic samples (scenarios.json + documents) used by the seeder
VERISENSE_SAMPLES=../samples
# Seed demo data automatically when the database is empty (1/0)
VERISENSE_AUTOSEED=1
# Optional fixed scrutiny date for reproducible demos (YYYY-MM-DD); default = today
# VERISENSE_REFERENCE_DATE=2026-10-26
VERISENSE_CORS_ORIGINS=http://localhost:5176,http://127.0.0.1:5176
# Effort-saved estimate assumptions (minutes of manual officer work)
VERISENSE_MANUAL_MINUTES_PER_DOCUMENT=12
VERISENSE_MANUAL_MINUTES_PER_APPLICATION=45
